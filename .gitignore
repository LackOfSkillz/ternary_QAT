# --- Raw literary reference corpus (never source-controlled) ---
# Third-party, in-copyright prose kept locally as a style/gold-standard reference only.
# Must never enter git history or any redistributable artifact.
training text/

# --- Dispatch 30A fantasy-compositional-sft-pilot: private data-bearing paths ---
# Gary's manuscript-derived records, model outputs, checkpoints, reviews, and any
# manifest that embeds manuscript or same-world content NEVER enter git. Design
# scaffolding (schemas/, freeze/, configs/, scripts/, reports/, professional-reference
# manifest with hashes only) IS committed.
experiments/fantasy-compositional-sft-pilot/datasets/
experiments/fantasy-compositional-sft-pilot/outputs/
experiments/fantasy-compositional-sft-pilot/checkpoints/
experiments/fantasy-compositional-sft-pilot/reviews/
experiments/fantasy-compositional-sft-pilot/manifests/manuscript-source-scenes.jsonl
experiments/fantasy-compositional-sft-pilot/manifests/atomic-records.jsonl
experiments/fantasy-compositional-sft-pilot/manifests/compositional-records.jsonl
experiments/fantasy-compositional-sft-pilot/manifests/replay-records.jsonl
experiments/fantasy-compositional-sft-pilot/manifests/eval-same-world.jsonl

# --- Dispatch 30A-R1 professional-fantasy-packet-sft-r1: private data-bearing paths ---
# Verbatim source/target excerpts, offset-bearing passage manifests (offsets into a named book
# are retrieval keys), model outputs, checkpoints, and reviews NEVER enter git. Committed:
# schemas/, freeze/, scripts/, reports/ (stats only), the hash-only source manifest, and the
# ORIGINAL eval sets (original-world + non-fantasy).
experiments/professional-fantasy-packet-sft-r1/private-data/
experiments/professional-fantasy-packet-sft-r1/datasets/
experiments/professional-fantasy-packet-sft-r1/outputs/
experiments/professional-fantasy-packet-sft-r1/checkpoints/
experiments/professional-fantasy-packet-sft-r1/reviews/
experiments/professional-fantasy-packet-sft-r1/manifests/candidate-passages.jsonl
experiments/professional-fantasy-packet-sft-r1/manifests/accepted-passages.jsonl
experiments/professional-fantasy-packet-sft-r1/manifests/rejected-passages.jsonl
experiments/professional-fantasy-packet-sft-r1/manifests/provenance-packets.jsonl
experiments/professional-fantasy-packet-sft-r1/manifests/atomic-records.jsonl
experiments/professional-fantasy-packet-sft-r1/manifests/compositional-records.jsonl
experiments/professional-fantasy-packet-sft-r1/manifests/replay-records.jsonl
experiments/professional-fantasy-packet-sft-r1/manifests/eval-heldout-professional.jsonl

# --- Model weights / checkpoints (never source-controlled) ---
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf

# --- Hugging Face caches and downloaded model directories ---
.hf_cache/
hf_cache/
huggingface/
**/models--*/
**/hub/

# --- Experiment heavy outputs: keep directory structure + small text files ---
# Checkpoint contents (keep the dir via .gitkeep)
experiments/checkpoints/**
!experiments/checkpoints/.gitkeep
# Generated datasets not approved for source control (keep the dir)
experiments/datasets/**
!experiments/datasets/.gitkeep
# Large runtime logs (keep the dir)
experiments/logs/**
!experiments/logs/.gitkeep

# --- Large runtime logs anywhere / temporary export directories ---
*.log
**/export-tmp/
**/*.export-tmp/

# Note: YAML configs, schema docs, manifests, approved benchmark definitions,
# small summary results, and scripts are intentionally NOT ignored.

# --- Dataset A smoke-training run outputs (keep dir structure + small text) ---
# Model binaries are already covered by *.safetensors/*.bin/*.pt/*.gguf above.
training/runs/**/checkpoints/**
training/runs/**/logs/**
training/runs/**/tensorboard/**
training/runs/**/cache/**
training/runs/**/optimizer*
training/runs/**/*.ckpt
!training/runs/**/.gitkeep
# Keep small trackable metrics/configs/reports:
!training/runs/**/*.json
!training/runs/**/*.md
!training/runs/**/*.yaml

# Machine-specific run artifacts (absolute paths, mtimes, temp refs). Regenerable;
# their RESULTS are summarized in training/reports/. Keep only deterministic
# baseline evidence (base/eval-*.json) trackable.
training/runs/**/integrity/**
training/runs/**/rehearsal/**

# GX10 HF-verification machine-specific raw artifacts (regenerable; results are in
# hf-verify-summary.json + the *-verification.json + the verification report).
training/runs/**/integrity-hf/base-model-before.json
training/runs/**/integrity-hf/base-model-after-*.json
training/runs/**/rehearsal-hf-*/

# Dispatch 18B machine-specific raw run artifacts (regenerable; results are in
# train-18b-summary.json, the eval JSONs, final-verification.json, and the report).
training/runs/**/integrity-18b/base-model-*.json
training/runs/**/integrity-18b/repository-*.json
training/runs/**/lora/run-manifest.json
training/runs/**/ternary-qat/run-manifest.json
training/runs/**/ternary-qat/eval.json

# Dispatch 19 QAT calibration machine-specific raw artifacts (regenerable; results
# are in qat-calibration-summary.json, eval JSONs, comparison, final-verification).
training/runs/**/lr-*/checkpoints/
training/runs/**/lr-*/run-manifest.json
training/runs/**/lr-*/integrity/
training/runs/dataset-a-qat-calibration-v1/integrity/base-model-*.json
training/runs/dataset-a-qat-calibration-v1/integrity/repository-*.json

# Dispatch 24 LWDB battery run outputs: commit the frozen plan/manifests/preflight/report;
# ignore bulky generated model outputs and per-run ledger dbs (regenerable from the plan).
# bulky/raw model-output dirs stay out of git; small summaries (corpus, run summary,
# item-level verdicts, report) are committed as durable evidence + hashes.
benchmarks/runs/**/normalized-results/
benchmarks/runs/**/raw-results/
benchmarks/runs/**/comprehension-results/
benchmarks/runs/**/comprehension-normalized/
benchmarks/runs/**/mechanical-results/
benchmarks/runs/**/slop-reports/
benchmarks/runs/**/reviewer-packets/
benchmarks/runs/**/logs/
benchmarks/runs/**/*.sqlite
# Dispatch 25: blind-review access separation — anonymous units and the private identity key
# are raw run artifacts (never committed); the enforcement code + tests + README are committed.
benchmarks/runs/**/review/
benchmarks/runs/**/private-unblinding/

# Dispatch 20 full-comparison machine-specific raw artifacts. Checkpoints, integrity/**
# (base-model-*/repository-* inventories, whose verdicts are echoed in the tracked
# full-comparison-summary.json), and run-manifest.json are already covered by the
# generic rules above. Re-include the QAT eval.json for THIS run only (the generic
# ternary-qat/eval.json ignore near the top is Dispatch-18B-specific).
!training/runs/dataset-a-full-comparison-v1/ternary-qat/eval.json
benchmarks/runs/**/fr-normalized-results/
