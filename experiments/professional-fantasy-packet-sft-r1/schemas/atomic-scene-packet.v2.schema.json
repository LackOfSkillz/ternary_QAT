{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "professional-fantasy-packet-sft-r1/atomic-scene-packet.v2.schema.json",
  "title": "Atomic scene packet v2 (Dispatch 30A-R1)",
  "description": "Abstracted, model-visible atomic packet: 1-2 clean, independently interpretable transferable obligations. Same task (packet -> full scene) and same unchanged gold target as its compositional twin; only constraint density differs. No source identifiers/names/wording.",
  "type": "object",
  "required": ["packet_version", "task", "viewpoint", "tense", "required_beats", "output_contract",
               "constraint_accounting"],
  "additionalProperties": false,
  "properties": {
    "packet_version": {"const": "atomic-scene-packet-v2"},
    "task": {"const": "write_scene"},
    "viewpoint": {"type": "string"},
    "tense": {"type": "string", "enum": ["past", "present"]},
    "scene_purpose": {"type": ["string", "null"]},
    "required_beats": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}},
    "output_contract": {"const": "prose_scene"},
    "constraint_accounting": {
      "type": "object", "required": ["meaningful_constraints"], "additionalProperties": false,
      "properties": {"meaningful_constraints": {"type": "integer", "minimum": 1, "maximum": 2},
        "hidden_compound_constraints": {"type": "integer", "maximum": 0}}}
  }
}
