{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "professional-fantasy-packet-sft-r1/provenance-packet.v2.schema.json",
  "title": "Provenance packet v2 (Dispatch 30A-R1)",
  "description": "Detailed private interpretation of one target passage. May contain source-specific information (never model-visible). Describes what the passage actually requires. Lives only in git-ignored storage.",
  "type": "object",
  "required": ["schema_version", "passage_id", "source_filename", "target_sha256", "viewpoint",
               "opening_state", "scene_purpose", "scene_boundary", "ending_state", "required_beats",
               "scene_function"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "provenance-packet-v2"},
    "passage_id": {"type": "string"},
    "source_filename": {"type": "string"},
    "target_sha256": {"type": "string"},
    "viewpoint": {
      "type": "object", "required": ["person", "tense"], "additionalProperties": true,
      "properties": {"character": {"type": "string"}, "person": {"type": "string"},
                     "tense": {"type": "string"}, "narrative_distance": {"type": "string"},
                     "stability": {"type": "string"}}},
    "opening_state": {"type": "string"},
    "scene_purpose": {"type": "string"},
    "scene_boundary": {"type": "string"},
    "ending_state": {"type": "string"},
    "required_beats": {
      "type": "array", "minItems": 3, "maxItems": 9,
      "items": {"type": "object", "required": ["beat_id", "description", "support", "importance"],
        "additionalProperties": true,
        "properties": {"beat_id": {"type": "string"}, "description": {"type": "string"},
          "support": {"enum": ["explicitly_supported", "strongly_implied", "weakly_inferred", "unverifiable", "contradicted"]},
          "importance": {"enum": ["load_bearing", "supportive", "incidental", "retrieval_risk", "ambiguous"]},
          "sequence_position": {"type": ["integer", "string", "null"]},
          "verifier_candidate": {"type": ["boolean", "string", "null"]}}}},
    "canon_constraints": {"type": "array", "items": {"type": "object",
      "required": ["constraint_id", "description", "support", "importance"], "additionalProperties": true,
      "properties": {"constraint_id": {"type": "string"}, "description": {"type": "string"},
        "support": {"enum": ["explicitly_supported", "strongly_implied", "weakly_inferred", "unverifiable", "contradicted"]},
        "importance": {"enum": ["load_bearing", "supportive", "incidental", "retrieval_risk", "ambiguous"]}}}},
    "character_goals": {"type": "array", "items": {"type": "string"}},
    "knowledge_limits": {"type": "array", "items": {"type": "string"}},
    "forbidden_developments": {"type": "array", "items": {"type": "string"}},
    "physical_continuity": {"type": "array", "items": {"type": "string"}},
    "emotional_progression": {"type": ["string", "array", "null"]},
    "reveal_structure": {"type": ["string", "array", "null"]},
    "scene_function": {"type": "string"},
    "craft_characteristics": {"type": ["object", "string", "null"]},
    "context_dependencies": {"type": ["string", "array", "null"]},
    "ambiguities": {"type": ["string", "array", "null"]}
  }
}
